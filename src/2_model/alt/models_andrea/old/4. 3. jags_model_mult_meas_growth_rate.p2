model {
    ######################
    # Observation model
    ######################
    # DAU - counts
    for (j in 1:27) {
        for (t in 1:116) {
            for (m in 1:7) {
                F[j, t, m] ~ dbin(nuF[j, t], N[j, t])
            }}}

    for (j in 1:27) {
        for (t in 44:116) {
            for (m in 1:7) {
                G1[j, t, m] ~ dbin(nuG[j, t], N[j, t])
            }}}


    for (j in 1:27) {
            nuF[j, 1] <- nuF0[j]
       for (t in 2:116) {
            nuF[j, t] ~ dbeta(1, 1)
           }}
        
    for (j in 1:27) {
      for (t in 44:116) {
            nuG[j, t] ~ dbeta(1, 1)
        }}

    #########################
    # Population model
    #########################
    # Initial population is observed
    for (j in 1:27) {
        N[j, 1] <- N0_obs[j] }
    
    # Total population at time t
    for (t in 2:116) {
        N_total[t] <- sum(N[1:27, 1]) + ref_in[t] - ref_out[t] }
    
    # Growth and adjustment
    for (j in 1:27) {
      for (t in 2:116) {
        growth_rate[j, t] ~ dnorm(0, 0.8)
        N_star[j, t] ~ dpois(N[j, t - 1] * exp(growth_rate[j, t]))   
        
        N[j, t] <- round(N_star[j, t] * scaling_factor[t])
            }}
        
    for (t in 2:116) {
      N_sum[t] <- sum(N_star[1:27, t])
      scaling_factor[t] <- N_total[t] / N_sum[t] }
     
     
}


