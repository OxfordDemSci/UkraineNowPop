model {
    ######################
    # Observation model
    ######################
    # DAU - counts
    for (t in FObs_data) {
        F[t] ~ dbin( nuF[meas[t]], N[meas[t]] ) 
        }
            
            
    for (t in GObs_data) {
        G1[t] ~ dbin( nuG[meas[t]], N[meas[t]] ) 
        }
            

    for (i in 1:3132) {
            nuF[i] ~ dbeta(1, 1)    }
    
    for (i in 44:3132) {
            nuG[i] ~ dbeta(1, 1) }
    

    #########################
    # Population model
    #########################
    for(t in 1:27){
    N[t] ~ dpois( lambda[t] )
    
    lambda[t] <- N0_obs[t]
    }
                
    for(t in 28:3132){
      N[t] ~ dpois( u0[location[t]] )
      
    }
    
    for(j in 1:27) { 
      u0[j] ~ dpois( 5E6 )
    }
}
