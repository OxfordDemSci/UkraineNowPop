
library("tidyverse")
library("readr")

parent_dir <- "~/DemSci/projects/2023_WHO_Ukraine_Population/deliverables/20240305 Deterministic Estimates/extract/Ukraine_population_estimates_2203/Ukraine_population_estimates_2023/oblast_daily_population/model"  

all_subdirs <- list.dirs(path = parent_dir, full.names = TRUE, recursive = FALSE)
all_subdirs

date_pattern <- "^\\d{4}-\\d{2}-\\d{2}$"

target_date <- seq(as.Date("2022-02-25"), 
                   as.Date("2024-05-14"), by = "day")
target_date <- target_date[weekdays(target_date) == "Sunday"]
target_date


date_subdirs <- all_subdirs[str_detect(basename(all_subdirs), date_pattern)]
filtered_subdirs <- date_subdirs[basename(date_subdirs) %in% target_date]
filtered_subdirs


target_filename <- "population_current.csv"


population_data_list <- list()

for (subdir in filtered_subdirs) {
  
  file_path <- file.path(subdir, target_filename)
  if (file.exists(file_path)) {
    
    data <- tryCatch(
      {
        read_csv(file_path) 
      },
      error = function(e) {
        message(paste("Error reading file:", file_path))
        message("Error message:", e$message)
        return(NULL)
      }
    )
    
    if (!is.null(data)) {
      # Adding a column indicating the source folder/date
      data <- data %>%
        mutate(Source_Folder = basename(subdir))
      
      population_data_list[[basename(subdir)]] <- data
    }
    
  } else {
    message(paste("File not found:", file_path))
  }
}


# Combine all data frames into one
combined_population_data_2023 <- bind_rows(population_data_list, .id = "Source_Folder") %>%
  dplyr::select(ADM1_PCODE, Source_Folder, total) %>%
  rename(pcode = ADM1_PCODE,
         wk = Source_Folder,
         DL_estimate_23 = total) %>%
  mutate(wk = as.Date(wk)) 

comparison1 <- combined_population_data_2023 %>%
  right_join(fit_1_base_model)  # modify depending on name in the pipeline


ggplot(comparison1 %>% filter(macroregion=="North"), 
                    aes(x = wk, 
                        y = count, 
                        color = source)) +
  geom_line() +               
  #geom_point() +              
  facet_wrap(~ macroregion*geo_name, scales = "free_x") +
  labs(x = "Region", y = "Value", color = "Variable") +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 90, hjust = 1)) 

