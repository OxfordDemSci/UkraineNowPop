model {
    ######################
    # Observation model
    ######################
    # DAU - counts
    for (j in 1:27) {        
      for (t in 1:116) {
          for (m in 1:7) {
            F[j, t, m] ~ dbin(nuF[j,t], N[j, t])  }}}    
                  
    for (j in 1:27) {        
      for (t in 44:116) {
          for (m in 1:7) {
            G1[j, t, m] ~ dbin(nuG[j,t], N[j, t]) }}}
    
    
    
    ### Facebook penetration rate              
    for (j in 1:27) {     
        thetaF[j, 1] <- logit(nuF0[j]) 

        for (t in 2:116) {
            thetaF[j, t] ~ dnorm(thetaF[j, t-1], tau_F) 
            nuF[j, t] <- ilogit(thetaF[j, t])  
        }}
         
    ### Instagram penetration rate              
    for (j in 1:27) {
         nuG[j, 43] <- ilogit(thetaG0[j])
         thetaG[j, 43] <- thetaG0[j]
         
      for (t in 44:116) {
         nuG[j, t] <- ilogit(thetaG[j, t])
         
         thetaG[j, t] ~ dnorm(thetaG[j, t-1], tau_G)
      }}
            
    for (j in 1:27) {
        thetaG0[j] ~ dnorm(0, 1) }
         
    
         
    
    # Priors
    tau_F ~ dgamma(1.25, 1.25)
    
    tau_G ~ dgamma(0.7, 0.9)
       
    
    #########################
    # Population model
    #########################
    for (j in 1:27) {
        N[j, 1] <- N0_obs[j]
        
      for (t in 2:116) {
        N[j, t] <- round(prop[j, t] %*% ( sum( N[1:27, 1] ) + ref_in[t] - ref_out[t] ))   }}
  
    
    # Proportions
    for (t in 2:116) {
        prop[1:27, t] ~ ddirich(alpha_prop[1:27])  
    }
    
    for (j in 1:27) {
        alpha_prop[j] ~ dgamma(2, 1) 
    }

    
    # Define tau_N
    tau_N <- 1 / pow(sigma_N, 2)
    sigma_N ~ dnorm(0, 2) T(0,)
}
